# ---- update server (apps/server) ----
# Public HTTPS origin of the server; becomes the passes' webServiceURL.
PUBLIC_URL=https://passforge.example.com
# Origin of the static web app (GitHub Pages), for CORS.
CORS_ORIGIN=https://example.github.io
# Authentik OIDC provider (issuer ends with a slash), the public client's id, and the group allowed to use live cards.
OIDC_ISSUER=https://auth.example.com/application/o/passforge/
OIDC_CLIENT_ID=change-me
OIDC_GROUP=passforge
# 32 random bytes, base64: openssl rand -base64 32. Losing it makes stored sessions unreadable.
ENCRYPTION_KEY=
# How often each live pass refreshes its upstream session and balance.
REFRESH_MINUTES=30
# Optional: send upstream (shop) traffic through a proxy on a Russian IP, e.g. over Tailscale.
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://homelab.tailnet-name.ts.net:8888

# ---- compose (Caddy) ----
DOMAIN=passforge.example.com
# UPSTREAM=homelab.tailnet-name.ts.net:8080

# ---- web app build (apps/web, or GitHub repository variables) ----
# VITE_OIDC_ISSUER=https://auth.example.com/application/o/passforge/
# VITE_OIDC_CLIENT_ID=change-me
# VITE_SERVER_URL=https://passforge.example.com
